ENVIRONMENT=test
DEBUG=false
API_PORT=8890
APP_PUBLIC_URL=https://rootagent.local
SERVICE_PUBLIC_HOST=rootagent.local
CORS_ORIGINS=https://rootagent.local
POSTGRES_HOST=infra-postgres
POSTGRES_PORT=5432
POSTGRES_DB=rootagent
POSTGRES_USER=rootagent
POSTGRES_PASSWORD=rootagent-ci-password
INFRA_HUB_POSTGRES_DB=main_db
REDIS_HOST=infra-redis
REDIS_PORT=6379
REDIS_PASSWORD=rootagent-ci-password
MINIO_ENDPOINT=infra-minio:9000
MINIO_ACCESS_KEY=rootagent
MINIO_SECRET_KEY=rootagent-ci-password
MINIO_BUCKET=rootagent
JWT_SECRET=ci-only-secret-with-at-least-thirty-two-bytes
JWT_ALGORITHM=HS256
LLM_API_KEY=
EXECUTOR_BACKEND=local
ALLOW_UNSAFE_LOCAL_EXECUTOR=false
BACKEND_LOG_FILE=/tmp/rootagent/backend.log
