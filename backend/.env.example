# =============================================================================
# RootAgent Backend Environment
# Copy to backend/.env and align with infra-hub credentials
# =============================================================================

# -----------------------------------------------------------------------------
# App / Deploy
# -----------------------------------------------------------------------------
API_PORT=8890
ENVIRONMENT=development
APP_PUBLIC_URL=https://rootagent.skt27182.com
APP_PUBLIC_HOST=rootagent.skt27182.com
SERVICE_PUBLIC_HOST=rootagent.skt27182.com
CORS_ORIGINS=http://localhost:5145,http://127.0.0.1:5145
# Only these exact addresses/CIDRs may supply X-Forwarded-For.
TRUSTED_PROXY_IPS=
DEBUG=true
LOG_LEVEL=INFO
# Production defaults to JSON automatically; set explicitly to opt in elsewhere.
LOG_FORMAT=
# Dev logs (Makefile default: ~/.local/share/projects/rootagent/dev-logs)
LOG_PATH=
# Optional app data root (default: ~/.local/share/projects/rootagent)
# APP_DATA_DIR=

# -----------------------------------------------------------------------------
# PostgreSQL (dedicated rootagent database)
# -----------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54321
POSTGRES_DB=rootagent
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
# Optional override:
# POSTGRES_URL=postgresql+asyncpg://admin:password123@localhost:54321/rootagent

POSTGRES_CONTAINER_NAME=infra-postgres

# -----------------------------------------------------------------------------
# Redis (chat/session history only)
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=63791
REDIS_PASSWORD=password123
REDIS_SSL=false
SESSION_TTL_SECONDS=172800
WS_TICKET_TTL_SECONDS=30
RUN_LOCK_TTL_SECONDS=3600
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=3600
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_WINDOW_SECONDS=3600

REDIS_CONTAINER_NAME=infra-redis

# -----------------------------------------------------------------------------
# MinIO
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=rootagent
MINIO_SECURE=false
STORAGE_THREADPOOL_WORKERS=4
STORAGE_STREAM_CHUNK_BYTES=1048576
MINIO_CONTAINER_NAME=infra-minio

# Upload and generated-output validation quotas
MAX_UPLOAD_BYTES=52428800
UPLOAD_SPOOL_BYTES=8388608
MAX_XLSX_ENTRIES=10000
MAX_XLSX_EXPANDED_BYTES=524288000
MAX_XLSX_COMPRESSION_RATIO=100
MAX_PNG_PIXELS=40000000
MAX_GENERATED_FILE_BYTES=52428800
MAX_GENERATED_RUN_BYTES=104857600
MAX_GENERATED_FILES_PER_RUN=20
MAX_ARTIFACT_PARSED_CELLS=1000000

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# infra-hub main_db (read-only; admins in main_db.users get INFRA_ADMIN in RootAgent)
INFRA_HUB_POSTGRES_DB=main_db
# Optional override:
# INFRA_HUB_POSTGRES_URL=postgresql://admin:password123@localhost:54321/main_db

# Swagger docs (HTTP Basic)
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=password123

# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=openrouter/amazon/nova-2-lite-v1:free
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Code executor
# -----------------------------------------------------------------------------
# local runs inside the API process and is NOT a security boundary.
EXECUTOR_BACKEND=local
ALLOW_UNSAFE_LOCAL_EXECUTOR=false
EXECUTOR_WORKSPACE_ROOT=/tmp/rootagent-workspaces
EXECUTOR_DEFAULT_DEADLINE_SECONDS=120
EXECUTOR_STDOUT_MAX_BYTES=65536
EXECUTOR_STDERR_MAX_BYTES=65536

# Required only when EXECUTOR_BACKEND=grpc. The gRPC backend in this release is
# an intentionally unavailable runtime stub.
GRPC_EXECUTOR_TARGET=
GRPC_EXECUTOR_TLS=true
# GRPC_EXECUTOR_CA_CERT=/run/secrets/sandbox-ca.pem
# GRPC_EXECUTOR_CLIENT_CERT=/run/secrets/sandbox-client.pem
# GRPC_EXECUTOR_CLIENT_KEY=/run/secrets/sandbox-client-key.pem
# GRPC_EXECUTOR_AUTH_TOKEN=
